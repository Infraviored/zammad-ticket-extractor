{
  "manifest_version": 2,
  "name": "Zammad Ticket Extractor",
  "version": "1.0.0",
  "description": "Extract and export Zammad ticket conversations to clipboard or JSON for AI analysis and data processing.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zammad-ticket-extractor@local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "64": "icon.svg"
  },
  "browser_action": {
    "default_title": "Zammad Ticket Extractor",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "activeTab",
    "tabs",
    "clipboardWrite",
    "downloads",
    "storage"
  ],
  "optional_permissions": [
    "<all_urls>"
  ]
}