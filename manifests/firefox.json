{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "zammad-ticket-extractor@local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "64": "icon.svg"
  },
  "browser_action": {
    "default_title": "Zammad Ticket Extractor",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "background": {
    "scripts": [
      "extract.js",
      "background.js"
    ]
  },
  "optional_permissions": [
    "<all_urls>"
  ]
}
